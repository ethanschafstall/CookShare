# Server
HOST=                 # Host the app binds to (e.g. 0.0.0.0 or localhost)
PORT=                 # Port the app listens on (e.g. 3000)

# Database
DATABASE_URL=         # Full connection string (overrides individual fields below)
DATABASE_USER=        # Database username
DATABASE_PASSWORD=    # Database password
DATABASE_NAME=        # Database name
DATABASE_HOST=        # Database host (e.g. localhost or db)
DATABASE_PORT=        # Database port (e.g. 5432)

# Default admin account (created on first run)
ADMIN_EMAIL=          # Admin login email
ADMIN_FIRSTNAME=      # Admin first name
ADMIN_LASTNAME=       # Admin last name
ADMIN_PASSWORD=       # Admin password

# Security & misc
PRIVATE_KEY=          # Secret key for signing tokens / encryption
CORS_ORIGIN=          # Allowed origin(s) for CORS (e.g. http://localhost:5173)
UPLOADS_DIR=          # Directory where uploaded files are stored