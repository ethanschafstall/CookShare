# Database
DB_ROOT_PASSWORD=     # Root/superuser password for the database
DB_NAME=              # Database name
DB_USER=              # Application database user
DB_PASSWORD=          # Application database user password
DB_PORT=              # Exposed database port

# Frontend
FRONTEND_PORT=        # Port the frontend is served on

# Backend
BACKEND_PORT=         # Port the backend listens on
HOST=                 # Backend host
PRIVATE_KEY=          # Secret key for signing tokens / encryption
ADMIN_EMAIL=          # Default admin login email
ADMIN_FIRSTNAME=      # Default admin first name
ADMIN_LASTNAME=       # Default admin last name
ADMIN_PASSWORD=       # Default admin password